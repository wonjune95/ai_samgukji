# PostgreSQL 일일 백업: 14일치를 보관한다
[Unit]
Description=AI Samgukji database backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/bin/sh -c 'pg_dump -Fc -d ai_samgukji -f /var/lib/pgsql/backups/ai_samgukji-$(date +%%F).dump && find /var/lib/pgsql/backups -name "ai_samgukji-*.dump" -mtime +14 -delete'
